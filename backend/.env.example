DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishguard
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
ML_MODEL_PATH=../ml_model/artifacts/phishguard_url_model.joblib
CORS_ORIGINS=http://localhost:5173
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://localhost:5000
MAIL_DELIVERY_ENABLED=0
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=simulation@phishguard.test
MAX_CAMPAIGN_RECIPIENTS=25
MAX_EMAILS_PER_HOUR=50
# The limits above apply to Mailpit. Gmail caps are fixed at 10 pending recipients
# per campaign and 20 successful Gmail campaign deliveries per rolling hour.
# Optional Gmail: generate a Fernet key locally using the command in
# docs/safe_email_delivery.md and keep it secret; never commit a generated value.
# Back up the database, run flask --app run.py upgrade-db, then restart Flask.
# Gmail campaigns also require MAIL_DELIVERY_ENABLED=1 and a public HTTPS URL.
# Preserve this key: changing it without re-encryption makes saved credentials
# unusable; a lost key requires deleting/recreating the profile with a new app password.
# Leave empty for the default Mailpit-only workflow.
SENDING_PROFILE_ENCRYPTION_KEY=
